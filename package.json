{
  "name": "alphapulse-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env.local --loader ts-node/esm server/index.ts || tsx --env-file=.env.local server/index.ts",
    "dev:server": "tsx watch --env-file=.env.local server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\" --names \"vite,server\" --prefix-colors \"cyan,green\"",
    "dev:stack": "powershell -ExecutionPolicy Bypass -File .\\start-local-stack.ps1",
    "demo": "tsx scripts/demo.ts",
    "health:runtime": "node scripts/verify-runtime-health.mjs",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --maxWorkers=1",
    "test:quant": "node scripts/run-quant-tests.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:demo": "playwright test -c playwright.demo.config.ts",
    "test:ci": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev || node scripts/apply-local-migrations.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-query-devtools": "^5.100.6",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.563.0",
    "node-cron": "^4.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "rss-parser": "^3.13.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^26.1.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.7"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
