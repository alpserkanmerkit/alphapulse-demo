# Local setup: copy this file to .env.local (.env.local is not committed).
GEMINI_API_KEY=
VITE_API_BASE_URL=http://localhost:3001
SERVER_PORT=3001
CORS_ORIGINS=http://localhost:3000
QUANT_ENGINE_URL=http://127.0.0.1:8000

DATABASE_URL=file:./prisma/dev.db

# REQUIRED (in every environment, including development): a random secret of at least 32 bytes. If empty or too short,
# the server cannot sign/verify tokens. To generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value.
JWT_SECRET=

REDIS_URL=
PDF_EXPORT_ENABLED=false
EXPORT_QUEUE_ENABLED=false
EXPORT_OUTPUT_DIR=output/exports
ENABLE_DB_GC=false

# Demo mode (no external services or keys needed): `npm run demo` sets this itself.
# Manually: DEMO_MODE=1. If GEMINI_API_KEY is empty and NODE_ENV!=production, it is enabled automatically at server startup; set DEMO_MODE=0 to disable.
DEMO_MODE=
